# BÜ Kampüs ÜRETİM ortamı şablonu. Kopyala: cp .env.prod.example .env.prod  (veya: bash scripts/ops/gen-secrets.sh)
# Bu dosyada YALNIZCA YER TUTUCU vardır. Gerçek sırlar .env.prod'a (gitignored, izin 600) yazılır.
# Sır yönetimi, rotasyon ve yedekleme: docs/KEY_MANAGEMENT.md

# --- Alan adı ve HTTPS (Caddy / Let's Encrypt) ---
# DNS A/AAAA kaydı bu sunucuya işaret etmeli; 80 ve 443 açık olmalı.
DOMAIN=kampus.example.edu.tr
# Let's Encrypt süre/uyarı e-postası
ACME_EMAIL=ops@example.edu.tr

# --- Profil ---
SPRING_PROFILES_ACTIVE=prod
APP_ENV=production

# --- Zorunlu sırlar (ProdSettingsValidator zayıf/boş değeri reddeder) ---
# openssl rand -base64 33
DB_PASSWORD=YER_TUTUCU_DB_SIFRESI
# >= 32 karakter, "dev-only" içeremez. Değişirse tüm oturumlar düşer. openssl rand -base64 48
JWT_SECRET=YER_TUTUCU_JWT_SIRRI_EN_AZ_32_KARAKTER
# Yönetici Basic auth şifresi (>= 12 karakter)
ADMIN_PASSWORD=YER_TUTUCU_YONETICI_SIFRESI
# Virgüllü; bu adresler ADMIN rolü alır
ADMIN_EMAILS=admin@example.edu.tr

# --- Şifreleme ana anahtarları (mesajlar + gönderi videoları) ---
# Biçim: id:base64(32 bayt), virgülle birden çok. Üretim: echo "k1:$(openssl rand -base64 32)"
# KAYIP = ŞİFRELİ VERİ KAYBI. En az 2 ayrı güvenli yerde yedekleyin (docs/KEY_MANAGEMENT.md).
CRYPTO_MASTER_KEYS=k1:YER_TUTUCU_BASE64_32_BAYT
# Yeni DEK'leri saran anahtar; eskiyi listeden SİLMEYİN (eski veriler için gerekir)
CRYPTO_ACTIVE_KEY_ID=k1
CRYPTO_REQUIRE_KEYS=true
CRYPTO_ADMIN_DECRYPT_ENABLED=true

# --- Cihaz kimliği HMAC anahtarı (>= 32 karakter; kalıcı tutun, değişirse cihaz engelleri eşleşmez) ---
DEVICE_HMAC_KEY=YER_TUTUCU_CIHAZ_HMAC_ANAHTARI_32_KARAKTER

# --- Web / CORS ---
CORS_ORIGINS=https://kampus.example.edu.tr
PUBLIC_WEB_URL=https://kampus.example.edu.tr
# Gizli yönetim yolu (web imajı derlenirken uygulanır). Boş = /admin
ADMIN_PATH=

# --- Erişim engeli: asla engellenmeyecek ağlar (virgüllü IP/CIDR; yönetici ofis çıkışı) ---
BAN_ALLOWLIST=
# Caddy dışında bir proxy varsa (CDN/LB) onun ağını ekleyin; varsayılan özel ağlar
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8

# --- E-posta (SMTP) --- Brevo ucretsiz SMTP (rehber: docs/MAIL_DELIVERABILITY.md bolum 9)
# Host/port/limitler Brevo'da degisebilir: kayit sirasinda panelden dogrulayin.
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Brevo paneli > SMTP & API > SMTP sayfasindaki "SMTP giris adi" (bukampus.online DEGILDIR; genelde xxxx@smtp-brevo.com bicimi)
MAIL_USERNAME=YER_TUTUCU_BREVO_SMTP_GIRIS_ADI
# Ayni sayfadaki SMTP ANAHTARI (SIR; asla commit etmeyin)
MAIL_PASSWORD=YER_TUTUCU_BREVO_SMTP_ANAHTARI
MAIL_FROM=noreply@bukampus.online
MAIL_REPLY_TO=ysufakin23@gmail.com
MAIL_REQUIRE_TLS=true
# Yalniz kod/guvenlik postasi gonderilir; duyuru dakikalik siniri dusuk tutulur
MAIL_MAX_PER_MINUTE=20
# Gunluk kota korumasi: Brevo ucretsiz ~300/gun (kayit sirasinda dogrulayin). Duyuru yalniz LIMIT-RESERVE altinda gider.
MAIL_DAILY_LIMIT=300
MAIL_DAILY_RESERVE=60
# Saglayici kota gununu hangi UTC saatinde sifirlar (21 = 00:00 Istanbul); Brevo icin dogrulayin
MAIL_DAILY_RESET_HOUR_UTC=21

# --- Push (Firebase servis hesabı anahtarı: ham JSON ya da base64, TEK SATIR). Boş = push kapalı ---
FCM_CREDENTIALS_JSON=

# --- Hata izleme (Sentry); boş = kapalı ---
SENTRY_DSN=

# --- Kaynak limitleri ---
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=2
POSTGRES_MEM_LIMIT=2g
POSTGRES_CPUS=2
REDIS_MEM_LIMIT=320m
JAVA_TOOL_OPTIONS=
# Gövde sınırları (video 40 MB); Caddy ve Spring
CADDY_MAX_BODY=55MB
MULTIPART_MAX_FILE=45MB
MULTIPART_MAX_REQUEST=50MB

# --- Medya: ffmpeg dönüştürme ve CDN (docs/MEDIA_PIPELINE.md) ---
MEDIA_TRANSCODE_ENABLED=true
MEDIA_TRANSCODE_WORKERS=2
# Boş = CDN kapalı. Örn. https://cdn.example.edu.tr (yalnızca imzalı URL; bkz. docs/DEPLOY.md bölüm 10)
MEDIA_CDN_BASE_URL=

# Eski DUZ gonderi videolarini arka planda sifreler (bitince false); bkz. scripts/ops/encrypt-existing-post-videos.sh
MEDIA_ENCRYPT_EXISTING=true
# Sizinti/rotasyon: DEK'i bu ana anahtarla sarili videolari aktif anahtarla yeniden sarar (normalde BOS)
MEDIA_RESEAL_KEY_ID=
MEDIA_CDN_REDIRECT=false

INITIAL_FILL=true

# --- Yedekleme (docs/BACKUP.md, docs/BACKUP_RESTORE.md) ---
# SAATLIK yedek (PostgreSQL + yuklenen dosyalar/fotograflar), en yeni 3 tutulur. .env/.env.prod yedege GIRMEZ (bkz. docs/BACKUP.md).
# age GENEL anahtari (age1...). ÖZEL anahtar sunucuda OLMAZ: age-keygen çıktısını çevrimdışı kasada saklayın.
BACKUP_AGE_RECIPIENT=age1YER_TUTUCU
# Ops.: haftalik otomatik geri yukleme dogrulamasi icin sunucuda ozel anahtari duran ikinci alici
BACKUP_VERIFY_AGE_RECIPIENT=
# ONERILIR: bos = yalnizca yerel (sunucu diski cokerse yedek de gider!). rclone uzak adi: ör. s3crypt:bu-yedek (deploy/rclone/rclone.conf)
BACKUP_REMOTE=
# Başarısızlık bildirimi (Slack/Discord/Telegram-uyumlu webhook); boş = yalnızca log + metrik + last-failure.json
BACKUP_WEBHOOK_URL=
BACKUP_KEEP_DAILY=3
BACKUP_KEEP_WEEKLY=0
BACKUP_KEEP_MONTHLY=0
# Durum JSON'u compose'ta SABITTIR (yedek: /var/backups/metrics/last-success.json, backend: /backup-status/last-success.json; ayni host
# dizini BACKUP_METRICS_DIR). BACKUP_STATUS_FILE'i burada AYARLAMAYIN. Basarisizlikta ayni dizinde last-failure.json.
# verify.key: host'ta `chown 70:70 deploy/backup-keys/verify.key && chmod 0400 ...` (zamanlayici uid 70 calisir; bkz. docs/BACKUP_RESTORE.md)
# ONERILIR: bildirim icin BACKUP_WEBHOOK_URL doldurun (yedek/dogrulama hatasi yoksa yalniz Prometheus uyarisi ile fark edilir).
# Zamanlama (konteyner saati Europe/Istanbul): her saat :05
BACKUP_CRON=5 * * * *
BACKUP_VERIFY_CRON=30 4 * * 0

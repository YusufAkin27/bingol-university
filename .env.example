# cp .env.example .env  (.env commit'lenmez; GERCEK SIRLARI buraya degil sunucudaki .env'e yazin)

# Profil: bos = yerel (profilsiz); "prod" = uretim (zorunlu ayarlar acilista dogrulanir, Swagger kapali, ayrinti yok);
# "dev" = yerel gelistirme (Swagger arayuzu acik, ayrintili log)
SPRING_PROFILES_ACTIVE=

# --- Zorunlu sirlar (prod: gelistirme degerleri reddedilir) ---
# Uretin: openssl rand -base64 36   (JWT_SECRET >= 32 karakter, "dev-only" iceremez)
DB_PASSWORD=degistir
JWT_SECRET=en-az-32-karakterlik-rastgele-bir-anahtar-yazin
# Yonetici Basic auth sifresi (prod: bos olamaz, >= 12 karakter onerilir)
ADMIN_PASSWORD=degistir

# E-posta (dogrulama kodu). MAIL_ENABLED=false iken kod yalnizca log'a yazilir.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@bukampus.online
# Uretim (Brevo) icin: MAIL_HOST=smtp-relay.brevo.com, MAIL_REQUIRE_TLS=true, MAIL_REPLY_TO=ysufakin23@gmail.com,
# MAIL_DAILY_LIMIT=300 (docs/MAIL_DELIVERABILITY.md bolum 9). Gercek kullanici/anahtari yalniz .env'e yazin.
MAIL_REPLY_TO=
MAIL_REQUIRE_TLS=false
MAIL_MAX_PER_MINUTE=30
MAIL_DAILY_LIMIT=0
MAIL_DAILY_RESERVE=60

# Bu e-postalar dogrulama/giriste ADMIN rolu alir (virgulle ayirin)
ADMIN_EMAILS=
# Yonetim paneli (tarayici) icin izin verilen kokenler, virgullu (bos birakirsaniz CORS kapali).
# prod: ZORUNLU, "*" olamaz, https kokenler. Ornek: https://kampus.bingol.edu.tr
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Push bildirim icin Firebase servis hesabi JSON yolu (konteyner ICINDEKI yol; bos ise push kapali)
FCM_CREDENTIALS_FILE=
# Herkese acik web adresi (destek talebi takip baglantilari icin)
PUBLIC_WEB_URL=http://localhost:8090
# Ilk acilista bos tablolari arka planda doldur (true/false)
INITIAL_FILL=true
# Swagger arayuzu (yalnizca yerel; prod'da her zaman kapali)
SWAGGER_UI_ENABLED=false

# Kaynak limitleri (compose); kucuk makinede dusurun
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=2
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=256m
# Ek JVM bayraklari (ornek yerel: -Xmx300m -XX:+UseSerialGC)
JAVA_TOOL_OPTIONS=
# Ayni makinede birden fazla yigin icin
BACKEND_PORT=8080

# Mesaj sifreleme ana anahtarlari: id:base64(32 bayt), virgulle birden cok. Uretin: openssl rand -base64 32
# Bos birakirsaniz yalnizca gelistirme icin UYARILI sabit anahtar kullanilir. Anahtar kaybi = mesaj kaybi (docs/ENCRYPTION.md)
CRYPTO_MASTER_KEYS=
CRYPTO_ACTIVE_KEY_ID=
CRYPTO_REQUIRE_KEYS=false
CRYPTO_ADMIN_DECRYPT_ENABLED=true

# Yonetim arayuzunun gizli yolu (web imaji derlenirken uygulanir). Bos = /admin. Ornek: /yonetim-ab12cd34ef56
ADMIN_PATH=

# Gelistirme tohum verisi (yalnizca yerel): SPRING_PROFILES_ACTIVE=dev,seed -> docs/DEV_SEED.md
# Tohum kullanicilarinin sabit DEV sifresi: DevSeed-2026!  (uretimde seed profili acilamaz)

# --- Depolama doluluk uyarisi (admin panel > Veri saklama) ---
# Esikler (%): >= warn WARN, >= crit CRIT. Veritabani sunucusu diskini OLCMEK icin DB ile ayni dosya sistemindeki,
# backend konteynerinden okunabilir bir dizin verin (STORAGE_DB_DISK_PATH); olmazsa VPS disk boyutunu bayt verin
# (STORAGE_DB_DISK_CAPACITY_BYTES, ornek 80 GB = 85899345920): kullanim DB + yukleme + yedek + STORAGE_RESERVED_BYTES.
OBS_STORAGE_WARN_PERCENT=80
OBS_STORAGE_CRIT_PERCENT=90
STORAGE_DB_DISK_PATH=
STORAGE_DB_DISK_CAPACITY_BYTES=0
STORAGE_RESERVED_BYTES=0

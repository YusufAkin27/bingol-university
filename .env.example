# cp .env.example .env  (.env commit'lenmez)
DB_PASSWORD=degistir
JWT_SECRET=en-az-32-karakterlik-rastgele-bir-anahtar-yazin
ADMIN_PASSWORD=degistir

# E-posta (dogrulama kodu). MAIL_ENABLED=false iken kod yalnizca log'a yazilir.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@bingol.edu.tr

# Bu e-postalar dogrulama/giriste ADMIN rolu alir (virgulle ayirin)
ADMIN_EMAILS=
# Yonetim paneli (tarayici) icin izin verilen kokenler, virgullu (bos birakirsaniz CORS kapali)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Push bildirim icin Firebase servis hesabi JSON yolu (bos ise push kapali)
FCM_CREDENTIALS_FILE=
# Ayni makinede birden fazla yigin icin
BACKEND_PORT=8080

# Mesaj sifreleme ana anahtarlari: id:base64(32 bayt), virgulle birden cok. Uretin: openssl rand -base64 32
# Bos birakirsaniz yalnizca gelistirme icin UYARILI sabit anahtar kullanilir. Anahtar kaybi = mesaj kaybi (docs/ENCRYPTION.md)
CRYPTO_MASTER_KEYS=
CRYPTO_ACTIVE_KEY_ID=
CRYPTO_REQUIRE_KEYS=false
CRYPTO_ADMIN_DECRYPT_ENABLED=true

# Yonetim arayuzunun gizli yolu (web imaji derlenirken uygulanir). Bos = /admin. Ornek: /yonetim-ab12cd34ef56
ADMIN_PATH=

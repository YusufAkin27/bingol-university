# BÜ Kampüs STAGING şablonu (docker-compose.prod.yml + docker-compose.staging.yml). YER TUTUCU değerler.
# Kopyala: cp .env.staging.example .env.staging && chmod 600 .env.staging
# Staging sırları ÜRETİMDEN FARKLI olmalı (özellikle JWT_SECRET, CRYPTO_MASTER_KEYS, DB_PASSWORD).
# Diğer tüm değişkenlerin açıklaması: .env.prod.example

DOMAIN=staging.kampus.example.edu.tr
ACME_EMAIL=ops@example.edu.tr
SPRING_PROFILES_ACTIVE=prod,staging
APP_ENV=staging

DB_PASSWORD=YER_TUTUCU_STAGING_DB_SIFRESI
JWT_SECRET=YER_TUTUCU_STAGING_JWT_SIRRI_EN_AZ_32_KARAKTER
ADMIN_PASSWORD=YER_TUTUCU_STAGING_YONETICI
ADMIN_EMAILS=admin@example.edu.tr

CRYPTO_MASTER_KEYS=s1:YER_TUTUCU_BASE64_32_BAYT
CRYPTO_ACTIVE_KEY_ID=s1
CRYPTO_REQUIRE_KEYS=true
DEVICE_HMAC_KEY=YER_TUTUCU_STAGING_CIHAZ_HMAC_32_KARAKTER

CORS_ORIGINS=https://staging.kampus.example.edu.tr
PUBLIC_WEB_URL=https://staging.kampus.example.edu.tr
ADMIN_PATH=
BAN_ALLOWLIST=

# Sahte SMTP (MailHog, docker-compose.staging.yml); gerçek kullanıcıya e-posta GİTMEZ
MAIL_ENABLED=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@staging.example.edu.tr

# Staging için ayrı Firebase projesi önerilir; boş = push kapalı
FCM_CREDENTIALS_JSON=
SENTRY_DSN=

MEDIA_TRANSCODE_ENABLED=true
MEDIA_TRANSCODE_WORKERS=1
MEDIA_CDN_BASE_URL=
INITIAL_FILL=true

BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1
POSTGRES_MEM_LIMIT=1g

BACKUP_AGE_RECIPIENT=age1YER_TUTUCU
BACKUP_REMOTE=
BACKUP_WEBHOOK_URL=

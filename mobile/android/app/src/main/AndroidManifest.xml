<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Ag erisimi (API, WebSocket, gorsel). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Sohbet gorselini galeriye kaydetme: yalniz Android 9 ve altinda gerekir. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" tools:replace="android:maxSdkVersion"/>
    <!-- Ilk giris izinleri: bildirim (Android 13+) ve rehber (yalniz kisi bulma). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <!-- Yerel ders/sinav hatirlatmalarini cihaz yeniden basladiktan sonra tekrar kurmak icin. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Akademik takvimi cihaz takvimine yazma (calisma zamani izni, kullanici "Takvime ekle" deyince istenir). -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <!-- Sinav/ders alarmini sistem Saat uygulamasina yazma (normal izin, ACTION_SET_ALARM). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM"/>
    <!-- Gerektikce istenenler: QR/foto cekme ve ses/video kaydi. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Sohbet galeri secici: Android 13+ medya izinleri, 12 ve alti icin okuma izni. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <!-- Android 14+ "secili fotograflar" kismi erisimi (galeri secici sinirli erisim kipinde calisir). -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application
        android:label="@string/app_name"
        android:name=".BuApplication"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartext}">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Paylasilan icerik baglantisi (https://bukampus.com.tr/s/{t}/{id}): dogrulanmis Android App Link; sunucuda
                 /.well-known/assetlinks.json (Play imzalama SHA-256) gerekir, yoksa baglanti tarayicida acilir. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="bukampus.com.tr" android:pathPrefix="/s/"/>
            </intent-filter>
            <!-- Ozel sema yedegi: bukampus://s/{t}/{id}. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="bukampus"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Derin baglantiyi Flutter'in kendi rota mekanizmasi degil app_links (ShareLinks) isler. -->
        <meta-data
            android:name="flutter_deeplinking_enabled"
            android:value="false" />
        <!-- FCM: eklentinin servisi/alicisi yerine alt siniflar (uygulama kapaliyken zengin kart NATIVE cizilir, Dart motoru acilmaz). -->
        <service android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService" tools:node="remove"/>
        <service android:name=".BuMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT"/></intent-filter>
        </service>
        <receiver android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingReceiver" tools:node="remove"/>
        <receiver android:name=".BuFcmReceiver" android:exported="true" android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter><action android:name="com.google.android.c2dm.intent.RECEIVE"/></intent-filter>
        </receiver>
        <receiver android:name=".RichPushActionReceiver" android:exported="false"/>
        <!-- Satir ici yanit kuyrugu: ag varken basliksiz Dart motoruyla gonderir (ReplyDispatcher). Disariya kapali. -->
        <service android:name=".ReplyRetryJobService" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE"/>
        <receiver android:name=".ReminderReceiver" android:exported="false"/>
        <!-- Yalniz sistem yayinlari (BOOT_COMPLETED vb.) alinir; exported=false disaridan sahte tetiklemeyi engeller
             (sistem yayinlari yine iletilir). rearmAll sadece yerel alarmlari yeniden kurar. -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <!-- KVKK veri dosyasi paylasimi: yalniz cache/export/ (xml/export_file_paths.xml), gecici okuma izniyle. -->
        <provider
            android:name=".ExportFileProvider"
            android:authorities="${applicationId}.exportprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_file_paths" />
        </provider>
        <!-- Push: sunucu chat / event / announcement / social / poll / academic kanallarini kullanir (MainActivity olusturur). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="announcement" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bu" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ paket gorunurlugu: Saat uygulamasi alarm kurma etkinligi (BuAlarm.isAvailable). -->
        <intent>
            <action android:name="android.intent.action.SET_ALARM"/>
        </intent>
    </queries>
</manifest>

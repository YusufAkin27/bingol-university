<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/qa_t0"
            android:background="@drawable/bw_chip12"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l0"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t1"
            android:background="@drawable/bw_chip12"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l1"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/qa_t2"
            android:background="@drawable/bw_chip12"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i2" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l2"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t3"
            android:background="@drawable/bw_chip12"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i3" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l3"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_utensils"
            android:tint="@color/bu_widget_text3"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/mn_hicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:textSize="10dp"
            android:lineHeight="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/mn_hcap"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/mn_logo" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/mn_c1"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:id="@+id/mn_c1head"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_w_sun"
                    android:tint="@color/bu_widget_text3"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:id="@+id/mn_c1icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="10dp"
                    android:lineHeight="12dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/bu_widget_text3"
                    android:textAlignment="viewStart"
                    android:textDirection="locale"
                    android:id="@+id/mn_c1cap"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_weight="1" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c1d0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c1d1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c1d2" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/bu_widget_border"
            android:id="@+id/mn_cdiv" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/mn_c2"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:orientation="horizontal"
                android:id="@+id/mn_c2head"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_w_sun"
                    android:tint="@color/bu_widget_text3"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:id="@+id/mn_c2icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textSize="10dp"
                    android:lineHeight="12dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/bu_widget_text3"
                    android:textAlignment="viewStart"
                    android:textDirection="locale"
                    android:id="@+id/mn_c2cap"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_weight="1" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c2d0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c2d1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/mn_c2d2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:id="@+id/mn_kcal_row"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_flame"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/mn_kicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/mn_total"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>

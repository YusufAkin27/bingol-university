<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:textSize="10dp"
            android:lineHeight="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/qa_hcap"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/qa_logo" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="17dp"
        android:lineHeight="22dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/qa_heading"
        android:letterSpacing="-0.01" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:textSize="12dp"
        android:lineHeight="16dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text3"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/qa_sub" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/qa_t0"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i0" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l0"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t1"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i1" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l1"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t2"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i2" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l2"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t3"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i3" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l3"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/qa_t4"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i4" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l4"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t5"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i5" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l5"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t6"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i6" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l6"
                android:gravity="center" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:id="@+id/qa_t7"
            android:background="@drawable/bw_chip14"
            android:gravity="center"
            android:layout_weight="1">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_w_search"
                android:tint="@color/bu_widget_text1"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:id="@+id/qa_i7" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/qa_l7"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

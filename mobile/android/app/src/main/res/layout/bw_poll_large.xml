<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_vote"
            android:tint="@color/bu_widget_text3"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/pl_hicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:textSize="10dp"
            android:lineHeight="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/pl_hcap"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/pl_logo" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="17dp"
        android:lineHeight="22dp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/pl_q"
        android:letterSpacing="-0.01" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/pl_o0">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o0_lbl"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o0_pct1"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o0_pct2"
                android:visibility="gone" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o0_barA"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_a"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o0_barB"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_b"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:id="@+id/pl_o1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o1_lbl"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o1_pct1"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o1_pct2"
                android:visibility="gone" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o1_barA"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_a"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o1_barB"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_b"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:id="@+id/pl_o2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o2_lbl"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o2_pct1"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o2_pct2"
                android:visibility="gone" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o2_barA"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_a"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o2_barB"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_b"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:id="@+id/pl_o3">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o3_lbl"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o3_pct1"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/pl_o3_pct2"
                android:visibility="gone" />
        </LinearLayout>
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o3_barA"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_a"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:id="@+id/pl_o3_barB"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/bw_bar_b"
            android:minHeight="4dp"
            android:maxHeight="4dp"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_gravity="start"
        android:textSize="13dp"
        android:lineHeight="16dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_inverse_fg"
        android:textAlignment="center"
        android:textDirection="locale"
        android:id="@+id/pl_pill"
        android:gravity="center"
        android:background="@drawable/bw_pill"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:paddingStart="14dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:id="@+id/pl_bottom"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_lock"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/pl_lock" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/pl_secret"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/pl_detail" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_chevron_right"
            android:tint="@color/bu_widget_text1"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/pl_chev" />
    </LinearLayout>
</LinearLayout>

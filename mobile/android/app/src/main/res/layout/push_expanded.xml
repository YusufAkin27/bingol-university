<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/push_card">
    <View android:id="@+id/push_critical" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="4dp" android:background="@drawable/push_critical_bar" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/push_section" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/push_muted" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/push_header_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/push_pill_gray" android:textColor="@color/push_gray_fg" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <ImageView android:id="@+id/push_avatar" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/push_brand" android:scaleType="centerCrop" android:contentDescription="@null"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="10dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/push_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/push_navy" android:textStyle="bold" android:textSize="16sp" android:maxLines="2" android:ellipsize="end"/>
                    <TextView android:id="@+id/push_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:background="@drawable/push_pill_red" android:textColor="@color/push_red_fg" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" android:visibility="gone"/>
                </LinearLayout>
                <TextView android:id="@+id/push_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/push_muted" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
                <TextView android:id="@+id/push_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/push_muted" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
                <TextView android:id="@+id/push_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:background="@drawable/push_pill_red" android:textColor="@color/push_red_fg" android:textStyle="bold" android:textSize="11sp" android:visibility="gone"/>
            </LinearLayout>
            <ImageView android:id="@+id/push_thumb" android:layout_width="56dp" android:layout_height="56dp" android:layout_marginStart="10dp" android:scaleType="centerCrop" android:contentDescription="@null" android:visibility="gone"/>
        </LinearLayout>
        <ImageView android:id="@+id/push_image" android:layout_width="match_parent" android:layout_height="wrap_content" android:adjustViewBounds="true" android:maxHeight="120dp" android:layout_marginTop="8dp" android:scaleType="fitCenter" android:contentDescription="@null" android:visibility="gone"/>
        <LinearLayout android:id="@+id/push_chips" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/push_chip_one" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/push_pill_red" android:textColor="@color/push_red_fg" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
            <TextView android:id="@+id/push_chip_two" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@drawable/push_pill_gray" android:textColor="@color/push_gray_fg" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/push_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/push_action_one" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/push_action" android:textColor="@color/push_navy" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:visibility="gone"/>
            <TextView android:id="@+id/push_action_two" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="8dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/push_action" android:textColor="@color/push_navy" android:textStyle="bold" android:textSize="12sp" android:maxLines="1" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

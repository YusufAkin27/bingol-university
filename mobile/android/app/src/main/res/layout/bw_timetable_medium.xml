<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_clock"
            android:tint="@color/bu_widget_text3"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/tt_hicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:textSize="10dp"
            android:lineHeight="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/tt_hcap"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/tt_logo" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:id="@+id/tt_r0"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp"
        android:paddingStart="8dp"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_inverse_fg"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r0_badge"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/bw_badge_inverse8"
                android:paddingTop="2dp"
                android:paddingEnd="0dp"
                android:paddingBottom="2dp"
                android:paddingStart="0dp" />
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r0_t1"
                android:gravity="center"
                android:visibility="gone" />
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r0_t2"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/tt_r0_title"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_w_map_pin"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/tt_r0_pin" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/tt_r0_room" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:id="@+id/tt_r1"
        android:paddingTop="0dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp"
        android:paddingStart="8dp"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_inverse_fg"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r1_badge"
                android:gravity="center"
                android:visibility="gone"
                android:background="@drawable/bw_badge_inverse8"
                android:paddingTop="2dp"
                android:paddingEnd="0dp"
                android:paddingBottom="2dp"
                android:paddingStart="0dp" />
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text1"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r1_t1"
                android:gravity="center"
                android:visibility="gone" />
            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="13dp"
                android:lineHeight="18dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text2"
                android:textAlignment="center"
                android:textDirection="locale"
                android:id="@+id/tt_r1_t2"
                android:gravity="center"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="13dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/tt_r1_title"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_w_map_pin"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/tt_r1_pin" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/tt_r1_room" />
    </LinearLayout>
</LinearLayout>

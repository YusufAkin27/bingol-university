<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/an_logo" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11dp"
            android:lineHeight="14dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_hcap"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11dp"
            android:lineHeight="14dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_last" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:background="@color/bu_widget_border" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:id="@+id/an_r0"
        android:gravity="center_vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text1"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_r0_title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_danger"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r0_urg"
                android:visibility="gone" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text3"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r0_meta"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bu_widget_border"
        android:id="@+id/an_div1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:id="@+id/an_r1"
        android:gravity="center_vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_r1_title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_danger"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r1_urg"
                android:visibility="gone" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text3"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r1_meta"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bu_widget_border"
        android:id="@+id/an_div2" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:id="@+id/an_r2"
        android:gravity="center_vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_r2_title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_danger"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r2_urg"
                android:visibility="gone" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text3"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r2_meta"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bu_widget_border"
        android:id="@+id/an_div3" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:id="@+id/an_r3"
        android:gravity="center_vertical"
        android:layout_weight="1">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14dp"
            android:lineHeight="18dp"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_r3_title" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_danger"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r3_urg"
                android:visibility="gone" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="11dp"
                android:lineHeight="14dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/bu_widget_text3"
                android:textAlignment="viewStart"
                android:textDirection="locale"
                android:id="@+id/an_r3_meta"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_w_megaphone"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/an_hicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="11dp"
            android:lineHeight="14dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_hcap"
            android:layout_weight="1" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="15dp"
        android:lineHeight="20dp"
        android:includeFontPadding="false"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/an_title"
        android:letterSpacing="-0.01" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11dp"
            android:lineHeight="14dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_danger"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_urg"
            android:visibility="gone" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="11dp"
            android:lineHeight="14dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/an_meta"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Uretilmis: mobile/tool/gen_android_widgets_layouts.py -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/bw_root"
    android:background="@drawable/bw_bg"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_message_square"
            android:tint="@color/bu_widget_text3"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/sc_hicon" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:textSize="10dp"
            android:lineHeight="12dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text3"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/sc_hcap"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:gravity="center_vertical"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/bw_logo"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:alpha="0.9"
            android:importantForAccessibility="no"
            android:id="@+id/sc_logo" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="34dp"
        android:lineHeight="38dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text1"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/sc_num"
        android:letterSpacing="-0.03" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:lineHeight="16dp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/bu_widget_text2"
        android:textAlignment="viewStart"
        android:textDirection="locale"
        android:id="@+id/sc_sub" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_w_bell"
            android:tint="@color/bu_widget_text2"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/sc_bicon" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/sc_n2" />
        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_w_heart"
            android:tint="@color/bu_widget_heart"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:id="@+id/sc_hicon2" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12dp"
            android:lineHeight="16dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/bu_widget_text2"
            android:textAlignment="viewStart"
            android:textDirection="locale"
            android:id="@+id/sc_n3"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>

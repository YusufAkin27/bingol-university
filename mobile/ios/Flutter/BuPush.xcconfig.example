// iOS push acma anahtari. Odemeli Apple Developer hesabi + GoogleService-Info.plist hazir oldugunda
// bu dosyayi "BuPush.xcconfig" adiyla kopyalayin (veya scripts/check-ios-push.ps1 -Enable calistirin).
// Dosya yokken imzalama push yetkisi istemez (ucretsiz Apple ID ile derleme bozulmaz).
BU_PUSH_ENTITLEMENTS = Runner/Runner.entitlements
BU_PUSH_ENTITLEMENTS[config=Release] = Runner/RunnerRelease.entitlements
// Ana ekran widget uzantisi (BUWidgets): App Group yetkisi. Ucretsiz Apple ID App Groups desteklemez; dosya yokken uzanti yetkisiz derlenir (widget veri okuyamaz).
BU_WIDGETS_ENTITLEMENTS = BUWidgets/BUWidgets.entitlements

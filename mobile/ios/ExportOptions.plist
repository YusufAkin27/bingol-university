<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight dışa aktarma şablonu. __TEAM_ID__ yer tutucusunu scripts/ios/build-ipa.sh doldurur
	     (IOS_TEAM_ID); bu dosyaya gerçek Team ID yazmak gerekmez. Sır içermez. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>destination</key>
	<string>export</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<!-- signingStyle=automatic iken Xcode bu sozlugu YOK SAYAR (bulut imzalama, build-ipa.sh). Elle imza (Codemagic
	     "xcode-project use-profiles" kendi export_options.plist'ini uretir) icin referans: paket kimligi -> Apple Developer'daki App Store profil ADI
	     (Codemagic referans adlari farkli olabilir; widget profili Apple'da bu_app_store_widgets adiyla acilir). -->
	<key>provisioningProfiles</key>
	<dict>
		<key>tr.com.bukampus.app</key>
		<string>bu_app_store</string>
		<key>tr.com.bukampus.app.NotificationService</key>
		<string>bu_notif_service</string>
		<key>tr.com.bukampus.app.NotificationContent</key>
		<string>bu_notif_content</string>
		<key>tr.com.bukampus.app.widgets</key>
		<string>bu_app_store_widgets</string>
	</dict>
</dict>
</plist>
